
extends Node3D

var player: CharacterBody3D

var body: MeshInstance3D
var head: MeshInstance3D
var left_arm: MeshInstance3D
var right_arm: MeshInstance3D
var left_leg: MeshInstance3D
var right_leg: MeshInstance3D

var walk_time: float = 0.0


func _ready() -> void:
	player = get_parent() as CharacterBody3D

	# ألوان الشخصية
	var skin = make_material(Color("#bd8056"))
	var shirt = make_material(Color("#eeeeee"))
	var pants = make_material(Color("#292d36"))
	var hair = make_material(Color("#24201d"))

	# الجسم
	body = make_part(
		Vector3(0, 1.15, 0),
		Vector3(0.65, 0.85, 0.35),
		shirt
	)

	# الرأس
	head = make_part(
		Vector3(0, 1.9, 0),
		Vector3(0.42, 0.48, 0.42),
		skin
	)

	# الشعر
	make_part(
		Vector3(0, 2.12, 0),
		Vector3(0.44, 0.16, 0.44),
		hair
	)

	# الذراعان
	left_arm = make_part(
		Vector3(-0.43, 1.15, 0),
		Vector3(0.20, 0.75, 0.22),
		skin
	)

	right_arm = make_part(
		Vector3(0.43, 1.15, 0),
		Vector3(0.20, 0.75, 0.22),
		skin
	)

	# الرجلان
	left_leg = make_part(
		Vector3(-0.17, 0.43, 0),
		Vector3(0.25, 0.78, 0.28),
		pants
	)

	right_leg = make_part(
		Vector3(0.17, 0.43, 0),
		Vector3(0.25, 0.78, 0.28),
		pants
	)


func make_material(color: Color) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.albedo_color = color
	return material


func make_part(
	part_position: Vector3,
	part_size: Vector3,
	material: Material
) -> MeshInstance3D:
	var part := MeshInstance3D.new()
	var mesh := BoxMesh.new()

	mesh.size = part_size
	part.mesh = mesh
	part.position = part_position
	part.material_override = material

	add_child(part)
	return part


func _process(delta: float) -> void:
	if not is_instance_valid(player):
		return

	var speed := Vector2(
		player.velocity.x,
		player.velocity.z
	).length()

	if speed > 0.2 and player.is_on_floor():
		walk_time += delta * speed * 2.5

		var swing := sin(walk_time) * 0.55

		left_leg.rotation.x = swing
		right_leg.rotation.x = -swing

		left_arm.rotation.x = -swing * 0.7
		right_arm.rotation.x = swing * 0.7
	else:
		left_leg.rotation.x = lerp(
			left_leg.rotation.x, 0.0, delta * 8.0
		)
		right_leg.rotation.x = lerp(
			right_leg.rotation.x, 0.0, delta * 8.0
		)
		left_arm.rotation.x = lerp(
			left_arm.rotation.x, 0.0, delta * 8.0
		)
		right_arm.rotation.x = lerp(
			right_arm.rotation.x, 0.0, delta * 8.0
		)
