static func all_regions() -> Array[Dictionary]:
	return REGIONS.duplicate(true)

static func find_region(region_name: String) -> Dictionary:
	for region in REGIONS:
		if str(region.get("name", "")) == region_name:
			return region.duplicate(true)
	return {}
